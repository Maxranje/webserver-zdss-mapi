{
    "type": "page",
    "title": "试卷列表",
    "body": {
        "type": "crud",
        "id": "paper_lists",
        "api": {
            "method": "post",
            "url": "/mapi/mock/paper_lists",
            "dataType": "form"
        },
        "perPage": 20,
        "perPageAvailable": [
            10,
            20,
            50
        ],
        "syncLocation": false,
        "labelTpl": "${pid}",
        "filter": {
            "title": "条件搜索",
            "submitText": "",
            "body": [
                {
                    "type": "input-text",
                    "name": "pids",
                    "label": "试卷Id",
                    "size": "md",
                    "placeholder": "多个用逗号分隔"
                },
                {
                    "type": "input-text",
                    "name": "qids",
                    "label": "试题Id",
                    "size": "md",
                    "placeholder": "多个用逗号分隔"
                },
                {
                    "type": "input-text",
                    "name": "title",
                    "size": "md",
                    "label": "试卷名称",
                    "placeholder": "模糊匹配"
                },
                {
                    "label": "类型",
                    "type": "select",
                    "clearable": true,
                    "name": "type",
                    "options": [
                        {
                            "label": "常规",
                            "value": "1"
                        },
                        {
                            "label": "评估",
                            "value": "2"
                        }
                    ]
                },
                {
                    "type": "submit",
                    "label": "搜索"
                }
            ]
        },
        "filterTogglable": true,
        "headerToolbar": [
            "filter-toggler",
            {
                "type": "button",
                "actionType": "dialog",
                "label": "新增",
                "className": "border-solid border-gray-100 rounded",
                "level": "info",
                "icon": "fa fa-plus",
                "dialog": {
                    "title": "新增",
                    "body": [
                        {
                            "type": "form",
                            "name": "paper-new-form",
                            "api": {
                                "method": "post",
                                "url": "/mapi/mock/paper_create",
                                "dataType": "form"
                            },
                            "onEvent": {
                                "click": {
                                    "actions": [
                                        {
                                            "actionType": "reload",
                                            "componentId": "paper_lists"
                                        }
                                    ]
                                }
                            },
                            "body": [
                                {
                                    "type": "input-text",
                                    "name": "title",
                                    "label": "试卷名称",
                                    "desc": "限定50字内",
                                    "required": true
                                },
                                {
                                    "type": "divider"
                                },
                                {
                                    "label": "类型",
                                    "type": "select",
                                    "clearable": true,
                                    "required": true,
                                    "name": "type",
                                    "value": 1,
                                    "options": [
                                        {
                                            "label": "常规",
                                            "value": "1"
                                        },
                                        {
                                            "label": "评估",
                                            "value": "2"
                                        }
                                    ],
                                    "desc": "常规试卷录题即出题, 评估试卷动态从录题中抽题考试, 详情参考录入页"
                                },
                                {
                                    "type": "divider"
                                },
                                {
                                    "type": "textarea",
                                    "showCounter": true,
                                    "maxLength": 200,
                                    "name": "remark",
                                    "label": "备注",
                                    "desc": "限定100字内"
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "type": "tpl",
                "tpl": "共有 ${total || 0} 条数据。",
                "className": "v-middle"
            },
            {
                "type": "pagination",
                "align": "right"
            }
        ],
        "footerToolbar": [
            "statistics",
            "switch-per-page",
            "pagination"
        ],
        "mode": "cards",
        "columnsCount": 4,
        "card": {
            "className": "mt-5 rounded-xl",
            "media": {
                "type": "image",
                "url": "$bg_img",
                "className": "w-full h-30 content-center rounded-br-none rounded-bl-none",
                "position": "top"
            },
            "header": {
                "title": "$title",
                "titleClassName": "text-black text-md",
                "subTitle": "$sub_title"
            },
            "toolbar": [
                {
                    "type": "tpl",
                    "visibleOn": "this.type == 2",
                    "tpl": "<span class=' label label-danger mr-2'>评估</span>"
                },
                {
                    "type": "tpl",
                    "visibleOn": "this.type == 3",
                    "tpl": "<span class=' label label-danger mr-2'>Word</span>"
                },
                {
                    "type": "dropdown-button",
                    "level": "link",
                    "align": "right",
                    "icon": "fa fa-ellipsis-h",
                    "hideCaret": true,
                    "buttons": [
                        {
                            "type": "button",
                            "actionType": "dialog",
                            "label": "编辑",
                            "className": "m-r-sm",
                            "disabledOn": "this.frequency > 0",
                            "primary": true,
                            "dialog": {
                                "title": "编辑",
                                "body": [
                                    {
                                        "type": "form",
                                        "name": "paper-edit-form",
                                        "api": {
                                            "method": "post",
                                            "url": "/mapi/mock/paper_update",
                                            "dataType": "form"
                                        },
                                        "onEvent": {
                                            "click": {
                                                "actions": [
                                                    {
                                                        "actionType": "reload",
                                                        "componentId": "paper_lists"
                                                    }
                                                ]
                                            }
                                        },
                                        "body": [
                                            {
                                                "type": "input-text",
                                                "name": "pid",
                                                "hidden": true
                                            },
                                            {
                                                "type": "input-text",
                                                "name": "title",
                                                "label": "试卷名称",
                                                "desc": "限定50字内",
                                                "required": true
                                            },
                                            {
                                                "type": "divider"
                                            },
                                            {
                                                "label": "测验类型",
                                                "type": "select",
                                                "clearable": true,
                                                "required": true,
                                                "name": "type",
                                                "options": [
                                                    {
                                                        "label": "常规",
                                                        "value": "1"
                                                    },
                                                    {
                                                        "label": "评估",
                                                        "value": "2"
                                                    }
                                                ],
                                                "desc": "常规试卷录题即出题, 评估试卷动态从录题中抽题考试, 详情参考录入页"
                                            },
                                            {
                                                "type": "divider"
                                            },
                                            {
                                                "type": "textarea",
                                                "showCounter": true,
                                                "maxLength": 200,
                                                "name": "remark",
                                                "label": "备注",
                                                "desc": "限定100字内"
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "type": "button",
                            "label": "录题",
                            "actionType": "drawer",
                            "drawer": {
                                "title": "录题",
                                "size": "xl",
                                "actions": [
                                    {
                                        "type": "button",
                                        "actionType": "cancel",
                                        "primary": true,
                                        "label": "关闭"
                                    }
                                ],
                                "body": [
                                    {
                                        "type": "service",
                                        "api": "/mapi/mock/paper_detail?pid=${pid}",
                                        "name": "paper_detail",
                                        "id": "paper_detail",
                                        "body": [
                                            {
                                                "type": "tpl",
                                                "className": "ml-4 block",
                                                "tpl": "<p style='font-weight:900;'>试卷信息</p>"
                                            },
                                            {
                                                "type": "property",
                                                "column": 3,
                                                "className": "border-solid border-gray-100 ml-4 rounded",
                                                "items": [
                                                    {
                                                        "label": "名称",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.title}</span>"
                                                    },
                                                    {
                                                        "label": "类型",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.type_info}</span>"
                                                    },
                                                    {
                                                        "label": "总题数",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.total_question}</span>"
                                                    },
                                                    {
                                                        "label": "备注",
                                                        "content": "<span class='text-gray-500  ml-2'>${paper.remark}</span>",
                                                        "span": 3
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "alert",
                                                "level": "warning",
                                                "className": "p-2 mt-5 ml-3 shadow rounded",
                                                "hiddenOn": "${paper.type != 1}",
                                                "showIcon": true,
                                                "body": "<div style='font-weight:bold;'>常规试卷最大录入${paper.input_total_question}道, 模考时按序全量出题. </div>"
                                            },
                                            {
                                                "type": "alert",
                                                "level": "warning",
                                                "className": "p-2 mt-5 ml-3 shadow rounded",
                                                "hiddenOn": "${paper.type != 2}",
                                                "showIcon": true,
                                                "body": "<div style='font-weight:bold;'>评估试卷最大录入${paper.input_total_question}道, 考试中考题是根据学员客观题(选择/填空)正确度进行动态调整,  所以录入试题尽可能每个难度均衡配置数量 (注意:主观题(写作/口语)无法实时判别, 一律认为正确) </div><div style='font-weight:bold; color:red;'>动态调整规则: 客观题(选择/填空)正确率>=0.75(10道题)即可提升难度 </div><div style='font-weight:bold; color:red;'>考试结束标准: 最少完成10道题, 最多50道, 未超过某难度 / 通过最高难度L5  </div>"
                                            },
                                            {
                                                "type": "tpl",
                                                "className": "ml-4 mt-10 block",
                                                "tpl": "<p style='font-weight:900;'>考题信息</p>"
                                            },
                                            {
                                                "type": "grid",
                                                "columns": [
                                                    {
                                                        "type": "wrapper",
                                                        "md": 5,
                                                        "body": [
                                                            {
                                                                "type": "crud",
                                                                "placeholder": "暂无考题",
                                                                "className": "border-solid border-gray-100 shadow p-2 rounded",
                                                                "source": "${questions}",
                                                                "syncLocation": false,
                                                                "checkOnItemClick": true,
                                                                "multiple": false,
                                                                "bulkActions": [
                                                                    {
                                                                        "label": "操作"
                                                                    }
                                                                ],
                                                                "onEvent": {
                                                                    "selectedChange": {
                                                                        "actions": [
                                                                            {
                                                                                "actionType": "reload",
                                                                                "componentId": "question_detail",
                                                                                "args": {
                                                                                    "qid": "${event.data.selectedItems[0].qid}"
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                },
                                                                "headerToolbar": [
                                                                    "bulkActions",
                                                                    {
                                                                        "label": "考题变更",
                                                                        "type": "button",
                                                                        "size": "sm",
                                                                        "icon": "fa fa-plus-circle",
                                                                        "className": "v-middle mb-2 text-sm border-solid border-gray-200 rounded bg-gray-100",
                                                                        "actionType": "dialog",
                                                                        "dialog": {
                                                                            "title": "增删",
                                                                            "size": "lg",
                                                                            "body": [
                                                                                {
                                                                                    "type": "form",
                                                                                    "name": "paper-add-question-form",
                                                                                    "api": {
                                                                                        "method": "post",
                                                                                        "url": "/mapi/mock/paper_addquestion?pid=${paper.pid}",
                                                                                        "dataType": "form"
                                                                                    },
                                                                                    "model": "horizontal",
                                                                                    "horizontal": {
                                                                                        "left": 0,
                                                                                        "right": 12,
                                                                                        "justify": false
                                                                                    },
                                                                                    "reload": "paper_detail",
                                                                                    "body": [
                                                                                        {
                                                                                            "type": "transfer",
                                                                                            "name": "paper_add_qids",
                                                                                            "searchable": true,
                                                                                            "menuTpl": "<div class='flex justify-between'><span>${label}</span><span class='text-muted m-r text-sm'>${tag}</span></div>",
                                                                                            "source": "/mapi/mock/question_lists?is_select=1&pid=${paper.pid}"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    },
                                                                    {
                                                                        "type": "tpl",
                                                                        "tpl": "试卷共 ${questions_total} 道题。",
                                                                        "className": "v-middle mb-2"
                                                                    }
                                                                ],
                                                                "footable": {
                                                                    "expand": "all"
                                                                },
                                                                "columns": [
                                                                    {
                                                                        "name": "qid",
                                                                        "type": "text",
                                                                        "hidden": true
                                                                    },
                                                                    {
                                                                        "name": "title",
                                                                        "type": "text"
                                                                    },
                                                                    {
                                                                        "name": "level",
                                                                        "type": "text"
                                                                    },
                                                                    {
                                                                        "type": "operation",
                                                                        "width": 20,
                                                                        "buttons": [
                                                                            {
                                                                                "type": "button",
                                                                                "label": "${score_info}",
                                                                                "level": "link",
                                                                                "actionType": "dialog",
                                                                                "disabledOn": "this.frequency > 0",
                                                                                "dialog": {
                                                                                    "title": "调整分值",
                                                                                    "body": [
                                                                                        {
                                                                                            "type": "form",
                                                                                            "name": "paper-update-question-form",
                                                                                            "reload": "paper_detail",
                                                                                            "api": {
                                                                                                "method": "post",
                                                                                                "url": "/mapi/mock/paper_updatequestion?pid=${paper.pid}&qid=${qid}",
                                                                                                "dataType": "form"
                                                                                            },
                                                                                            "body": [
                                                                                                {
                                                                                                    "type": "input-number",
                                                                                                    "name": "score",
                                                                                                    "min": 1,
                                                                                                    "max": 100,
                                                                                                    "value": "2",
                                                                                                    "unitOptions": [
                                                                                                        "分"
                                                                                                    ],
                                                                                                    "desc": "本次修改只限于当前考试过程, 不会影响到原试题分值"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "wrapper",
                                                        "md": 7,
                                                        "className": "border-solid border-gray-100 shadow-sm p-4 rounded-lg mt-5",
                                                        "body": [
                                                            {
                                                                "type": "service",
                                                                "id": "question_detail",
                                                                "name": "question_detail",
                                                                "initFetchSchema": false,
                                                                "schemaApi": "/mapi/mock/question_detail?qid=$qid&preview=1"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "type": "button",
                            "actionType": "ajax",
                            "label": "删除",
                            "disabledOn": "this.frequency > 0",
                            "confirmText": "您确认要删除试卷么? 只有未使用的试卷可删除",
                            "api": {
                                "method": "get",
                                "url": "/mapi/mock/paper_delete?pid=$pid"
                            }
                        }
                    ]
                }
            ]
        }
    }
}