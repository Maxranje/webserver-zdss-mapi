{
    "type": "page",
    "body": {
        "type": "crud",
        "id": "paper_lists",
        "api": {
            "method": "post",
            "url": "/mapi/mock/paper_lists",
            "dataType": "form"
        },
        "perPage": 20,
        "perPageAvailable": [
            10,
            20,
            50
        ],
        "syncLocation": false,
        "labelTpl": "${pid}",
        "filter": {
            "title": "条件搜索",
            "submitText": "",
            "body": [
                {
                    "type": "input-text",
                    "name": "pids",
                    "label": "试卷Id",
                    "placeholder": "多个用逗号分隔"
                },
                {
                    "type": "input-text",
                    "name": "qids",
                    "label": "试题Id",
                    "placeholder": "多个用逗号分隔"
                },
                {
                    "type": "input-text",
                    "name": "title",
                    "size": "md",
                    "label": "试卷名称",
                    "placeholder": "模糊匹配"
                },
                {
                    "label": "类型",
                    "type": "select",
                    "clearable": true,
                    "name": "type",
                    "options": [
                        {
                            "label": "常规考试",
                            "value": "1"
                        },
                        {
                            "label": "入学评估",
                            "value": "2"
                        },
                        {
                            "label": "单词本",
                            "value": "3"
                        }
                    ]
                },
                {
                    "type": "tree-select",
                    "name": "subject_id",
                    "onlyLeaf": true,
                    "searchable": true,
                    "label": "科目",
                    "size": "md",
                    "source": "/mapi/subject/lists?is_select=1&is_leaf=1"
                },
                {
                    "type": "tree-select",
                    "name": "source_ids",
                    "onlyLeaf": true,
                    "multiple": true,
                    "searchable": true,
                    "size": "md",
                    "label": "来源",
                    "source": "/mapi/mock/source_lists?is_select=1"
                },
                {
                    "type": "submit",
                    "label": "搜索"
                }
            ]
        },
        "filterTogglable": true,
        "headerToolbar": [
            "filter-toggler",
            {
                "type": "button",
                "actionType": "dialog",
                "label": "新增",
                "className": "border-solid border-gray-100 rounded",
                "level": "info",
                "icon": "fa fa-plus",
                "dialog": {
                    "title": "新增",
                    "body": {
                        "type": "form",
                        "name": "paper-new-form",
                        "api": {
                            "method": "post",
                            "url": "/mapi/mock/paper_create",
                            "dataType": "form"
                        },
                        "onEvent": {
                            "click": {
                                "actions": [
                                    {
                                        "actionType": "reload",
                                        "componentId": "paper_lists"
                                    }
                                ]
                            }
                        },
                        "body": [
                            {
                                "type": "input-text",
                                "name": "title",
                                "label": "试卷名称",
                                "desc": "限定100字内",
                                "required": true
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "label": "测验类型",
                                "type": "select",
                                "clearable": true,
                                "required": true,
                                "name": "type",
                                "options": [
                                    {
                                        "label": "常规考试",
                                        "value": "1"
                                    },
                                    {
                                        "label": "入学评估",
                                        "value": "2"
                                    },
                                    {
                                        "label": "单词本",
                                        "value": "3"
                                    }
                                ],
                                "desc": "入学评估题目会随学员作答情况来难易自动挑选, 需要多配置一些不同分段题, 单词本只考单词"
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "tree-select",
                                "name": "subject_id",
                                "onlyLeaf": true,
                                "searchable": true,
                                "label": "科目",
                                "source": "/mapi/subject/lists?is_select=1&is_leaf=1"
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "tree-select",
                                "name": "source_ids",
                                "onlyLeaf": true,
                                "multiple": true,
                                "searchable": true,
                                "maxLength": 3,
                                "label": "来源",
                                "desc": "最多3项",
                                "source": "/mapi/mock/source_lists?is_select=1"
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "textarea",
                                "showCounter": true,
                                "maxLength": 200,
                                "name": "remark",
                                "label": "备注",
                                "desc": "限定200字内"
                            }
                        ]
                    }
                }
            },
            {
                "type": "tpl",
                "tpl": "共有 ${total || 0} 条数据。",
                "className": "v-middle"
            },
            {
                "type": "pagination",
                "align": "right"
            }
        ],
        "footerToolbar": [
            "statistics",
            "switch-per-page",
            "pagination"
        ],
        "mode": "cards",
        "columnsCount": 4,
        "card": {
            "className": "mt-5 rounded-xl",
            "media": {
                "type": "image",
                "url": "$bg_img",
                "className": "w-full h-30 content-center rounded-br-none rounded-bl-none",
                "position": "top"
            },
            "header": {
                "title": "$title",
                "titleClassName": "text-black text-md",
                "subTitle": "$sub_title"
            },
            "toolbar": [
                {
                    "type": "tpl",
                    "visibleOn": "this.type == 2",
                    "tpl": "<span class=' label label-danger mr-2'>Assess</span>"
                },
                {
                    "type": "tpl",
                    "visibleOn": "this.type == 3",
                    "tpl": "<span class=' label label-danger mr-2'>Word</span>"
                },
                {
                    "type": "dropdown-button",
                    "level": "link",
                    "align": "right",
                    "icon": "fa fa-ellipsis-h",
                    "hideCaret": true,
                    "buttons": [
                        {
                            "type": "button",
                            "actionType": "dialog",
                            "label": "编辑",
                            "className": "m-r-sm",
                            "disabledOn": "this.frequency > 0",
                            "primary": true,
                            "dialog": {
                                "title": "编辑",
                                "body": {
                                    "type": "form",
                                    "name": "paper-edit-form",
                                    "api": {
                                        "method": "post",
                                        "url": "/mapi/mock/paper_update",
                                        "dataType": "form"
                                    },
                                    "onEvent": {
                                        "click": {
                                            "actions": [
                                                {
                                                    "actionType": "reload",
                                                    "componentId": "paper_lists"
                                                }
                                            ]
                                        }
                                    },
                                    "body": [
                                        {
                                            "type": "input-text",
                                            "name": "pid",
                                            "hidden": true
                                        },
                                        {
                                            "type": "input-text",
                                            "name": "title",
                                            "label": "试卷名称",
                                            "desc": "限定100字内",
                                            "required": true
                                        },
                                        {
                                            "type": "divider"
                                        },
                                        {
                                            "label": "测验类型",
                                            "type": "select",
                                            "clearable": true,
                                            "required": true,
                                            "name": "type",
                                            "options": [
                                                {
                                                    "label": "常规考试",
                                                    "value": "1"
                                                },
                                                {
                                                    "label": "入学评估",
                                                    "value": "2"
                                                },
                                                {
                                                    "label": "单词本",
                                                    "value": "3"
                                                }
                                            ],
                                            "desc": "入学评估题目会随学员作答情况来难易自动挑选, 需要多配置一些不同分段题, 单词本只考单词"
                                        },
                                        {
                                            "type": "divider"
                                        },
                                        {
                                            "type": "tree-select",
                                            "name": "subject_id",
                                            "onlyLeaf": true,
                                            "searchable": true,
                                            "label": "科目",
                                            "source": "/mapi/subject/lists?is_select=1&is_leaf=1"
                                        },
                                        {
                                            "type": "divider"
                                        },
                                        {
                                            "type": "tree-select",
                                            "name": "source_ids",
                                            "onlyLeaf": true,
                                            "multiple": true,
                                            "searchable": true,
                                            "label": "来源",
                                            "source": "/mapi/mock/source_lists?is_select=1"
                                        },
                                        {
                                            "type": "divider"
                                        },
                                        {
                                            "type": "textarea",
                                            "showCounter": true,
                                            "maxLength": 200,
                                            "name": "remark",
                                            "label": "备注",
                                            "desc": "限定200字内"
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "type": "button",
                            "label": "录入",
                            "actionType": "drawer",
                            "drawer": {
                                "title": "录入",
                                "size": "xl",
                                "actions": [
                                    {
                                        "type": "button",
                                        "actionType": "cancel",
                                        "primary": true,
                                        "label": "关闭"
                                    }
                                ],
                                "body": [
                                    {
                                        "type": "service",
                                        "api": "/mapi/mock/paper_detail?pid=${pid}",
                                        "name": "paper_detail",
                                        "id": "paper_detail",
                                        "body": [
                                            {
                                                "type": "tpl",
                                                "className": "ml-4 block",
                                                "tpl": "<p style='font-weight:900;'>试卷信息</p>"
                                            },
                                            {
                                                "type": "property",
                                                "column": 3,
                                                "className": "border-solid border-gray-100 ml-4 rounded",
                                                "items": [
                                                    {
                                                        "label": "名称",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.title}</span>",
                                                        "span": 3
                                                    },
                                                    {
                                                        "label": "类型",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.type_info}</span>"
                                                    },
                                                    {
                                                        "label": "科目",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.subject_name}</span>"
                                                    },
                                                    {
                                                        "label": "轮次",
                                                        "content": "<span class='text-black font-black ml-2'>${paper.frequency}次</span>"
                                                    },
                                                    {
                                                        "label": "备注",
                                                        "content": "<span class='text-gray-500  ml-2'>${paper.remark}</span>",
                                                        "span": 4
                                                    },
                                                    {
                                                        "label": "来源",
                                                        "content": {
                                                            "type": "each",
                                                            "className": "inline-block ml-2",
                                                            "name": "${paper.source_list}",
                                                            "items": {
                                                                "type": "tpl",
                                                                "tpl": "<span class='label bg-gray-400 text-xs'>${item}</span> "
                                                            }
                                                        },
                                                        "span": 4
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "tpl",
                                                "className": "ml-4 mt-10 block",
                                                "tpl": "<p style='font-weight:900;'>考题信息</p>"
                                            },
                                            {
                                                "type": "grid",
                                                "columns": [
                                                    {
                                                        "type": "wrapper",
                                                        "md": 5,
                                                        "body": [
                                                            {
                                                                "type": "crud",
                                                                "placeholder": "暂无考题",
                                                                "className": "border-solid border-gray-100 shadow p-2 rounded",
                                                                "source": "${questions}",
                                                                "syncLocation": false,
                                                                "headerToolbar": [
                                                                    {
                                                                        "label": "考题变更",
                                                                        "type": "button",
                                                                        "size": "sm",
                                                                        "icon": "fa fa-plus-circle",
                                                                        "className": "v-middle mb-2 text-sm border-solid border-gray-200 rounded bg-gray-100",
                                                                        "actionType": "dialog",
                                                                        "dialog": {
                                                                            "title": "增删",
                                                                            "size": "lg",
                                                                            "body": [
                                                                                {
                                                                                    "type": "form",
                                                                                    "name": "paper-add-question-form",
                                                                                    "api": {
                                                                                        "method": "post",
                                                                                        "url": "/mapi/mock/paper_addquestion?pid=${paper.pid}",
                                                                                        "dataType": "form"
                                                                                    },
                                                                                    "model": "horizontal",
                                                                                    "horizontal": {
                                                                                        "left": 0,
                                                                                        "right": 12,
                                                                                        "justify": false
                                                                                    },
                                                                                    "reload": "paper_detail",
                                                                                    "body": [
                                                                                        {
                                                                                            "type": "transfer",
                                                                                            "name": "paper_add_qids",
                                                                                            "searchable": true,
                                                                                            "menuTpl": "<div class='flex justify-between'><span>${label}</span><span class='text-muted m-r text-sm'>${tag}</span></div>",
                                                                                            "source": "/mapi/mock/question_lists?is_select=1&pid=${paper.pid}"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    },
                                                                    {
                                                                        "type": "tpl",
                                                                        "tpl": "试卷共 ${questions_total} 道题。",
                                                                        "className": "v-middle mb-2"
                                                                    }
                                                                ],
                                                                "itemAction": {
                                                                    "type": "button",
                                                                    "actionType": "reload",
                                                                    "target": "question_detail?qid=$qid"
                                                                },
                                                                "footable": {
                                                                    "expand": "all"
                                                                },
                                                                "columns": [
                                                                    {
                                                                        "name": "title",
                                                                        "type": "text"
                                                                    },
                                                                    {
                                                                        "name": "level",
                                                                        "type": "text"
                                                                    },
                                                                    {
                                                                        "type": "operation",
                                                                        "width": 20,
                                                                        "buttons": [
                                                                            {
                                                                                "type": "button",
                                                                                "label": "${score_info}",
                                                                                "level": "link",
                                                                                "actionType": "dialog",
                                                                                "dialog": {
                                                                                    "title": "调整分值",
                                                                                    "body": [
                                                                                        {
                                                                                            "type": "form",
                                                                                            "name": "paper-update-question-form",
                                                                                            "reload": "paper_detail",
                                                                                            "api": {
                                                                                                "method": "post",
                                                                                                "url": "/mapi/mock/paper_updatequestion?pid=${paper.pid}&qid=${qid}",
                                                                                                "dataType": "form"
                                                                                            },
                                                                                            "body": [
                                                                                                {
                                                                                                    "type": "input-number",
                                                                                                    "name": "score",
                                                                                                    "min": 1,
                                                                                                    "max": 100,
                                                                                                    "value": "2",
                                                                                                    "unitOptions": [
                                                                                                        "分"
                                                                                                    ],
                                                                                                    "desc": "本次修改只限于当前考试过程, 不会影响到原试题分值"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "type": "wrapper",
                                                        "md": 7,
                                                        "className": "border-solid border-gray-100 shadow-sm p-4 rounded-lg mt-5",
                                                        "body": [
                                                            {
                                                                "type": "service",
                                                                "id": "question_detail",
                                                                "name": "question_detail",
                                                                "initFetchSchema": false,
                                                                "schemaApi": "/mapi/mock/question_detail?qid=$qid&preview=1"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "type": "button",
                            "actionType": "ajax",
                            "label": "删除",
                            "disabledOn": "this.frequency > 0",
                            "confirmText": "您确认要删除试卷么? 只有未使用的试卷可删除",
                            "api": {
                                "method": "get",
                                "url": "/mapi/mock/paper_delete?pid=$pid"
                            }
                        }
                    ]
                }
            ]
        }
    }
}