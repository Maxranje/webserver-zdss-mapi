{
    "type": "page",
    "body": {
        "type": "crud",
        "id": "question_lists",
        "api": {
            "method": "post",
            "url": "/mapi/mock/question_lists",
            "dataType": "form"
        },
        "perPage": 20,
        "perPageAvailable": [
            10,
            20,
            30
        ],
        "syncLocation": false,
        "labelTpl": "${qid}",
        "filter": {
            "title": "条件搜索",
            "submitText": "",
            "body": [
                {
                    "type": "input-text",
                    "name": "qids",
                    "size": "sm",
                    "label": "试题Id",
                    "placeholder": "多个用英文逗号分隔"
                },
                {
                    "type": "input-text",
                    "name": "description",
                    "size": "md",
                    "label": "简述",
                    "placeholder": "模糊匹配简述"
                },
                {
                    "label": "题型",
                    "type": "select",
                    "size": "sm",
                    "clearable": true,
                    "name": "type",
                    "options": [
                        {
                            "label": "单选题",
                            "value": "1"
                        },
                        {
                            "label": "多选题",
                            "value": "2"
                        },
                        {
                            "label": "判断题",
                            "value": "3"
                        },
                        {
                            "label": "填空题",
                            "value": "4"
                        },
                        {
                            "label": "简答题",
                            "value": "5"
                        },
                        {
                            "label": "写作题",
                            "value": "6"
                        },
                        {
                            "label": "口语题",
                            "value": "7"
                        }
                    ]
                },
                {
                    "label": "难度",
                    "type": "select",
                    "size": "sm",
                    "clearable": true,
                    "name": "level",
                    "options": [
                        {
                            "label": "非常简单",
                            "value": "1"
                        },
                        {
                            "label": "简单",
                            "value": "2"
                        },
                        {
                            "label": "一般",
                            "value": "3"
                        },
                        {
                            "label": "较难",
                            "value": "4"
                        },
                        {
                            "label": "困难",
                            "value": "5"
                        }
                    ]
                },
                {
                    "type": "tree-select",
                    "name": "tag_ids",
                    "onlyLeaf": true,
                    "multiple": true,
                    "searchable": true,
                    "initiallyOpen": false,
                    "size": "md",
                    "label": "标签",
                    "source": "/mapi/mock/tag_lists?is_select=1"
                },
                {
                    "type": "tree-select",
                    "name": "source_ids",
                    "onlyLeaf": true,
                    "multiple": true,
                    "searchable": true,
                    "initiallyOpen": false,
                    "size": "md",
                    "label": "来源",
                    "source": "/mapi/mock/source_lists?is_select=1"
                },
                {
                    "type": "submit",
                    "label": "搜索"
                }
            ]
        },
        "filterTogglable": true,
        "headerToolbar": [
            "filter-toggler",
            {
                "type": "button",
                "label": "新增",
                "actionType": "link",
                "className": "border-solid border-gray-100 rounded",
                "level": "info",
                "icon": "fa fa-plus",
                "link": "/question/add"
            },
            {
                "type": "tpl",
                "tpl": "共有 ${total} 条数据。",
                "className": "v-middle"
            },
            {
                "type": "pagination",
                "align": "right"
            }
        ],
        "footerToolbar": [
            "statistics",
            "switch-per-page",
            "pagination"
        ],
        "mode": "cards",
        "columnsCount": 2,
        "card": {
            "className": "border-solid border-gray-100 shadow p-4 rounded-md mt-5 -mb-2 ",
            "header": {
                "className": "bg-white",
                "title": "$description",
                "titleClassName": "mt-2",
                "subTitle": "Qid:  $qid",
                "avatarText": "$state_info",
                "avatarTextClassName": "flex justify-center items-center text-lg font-black",
                "avatarTextBackground": [
                    "black"
                ]
            },
            "body": [
                {
                    "type": "property",
                    "column": 3,
                    "mode": "simple",
                    "className": "border-solid border-gray-100 shadow-md p-4 rounded-lg bg-gray-50",
                    "items": [
                        {
                            "label": "题型",
                            "content": "<span class='text-black font-black ml-2 text-xs'>$type_info</span>"
                        },
                        {
                            "label": "难度",
                            "content": {
                                "name": "level",
                                "label": "状态",
                                "type": "mapping",
                                "map": {
                                    "5": "<span class='label text-black text-xs text-red-500 ml-2'>困难</span>",
                                    "4": "<span class='label text-black text-xs text-yellow-500 ml-2'>较难</span>",
                                    "3": "<span class='label text-black text-xs text-yellow-500 ml-2'>一般</span>",
                                    "2": "<span class='label text-black text-xs text-green-500 ml-2'>简单</span>",
                                    "1": "<span class='label text-black text-xs text-green-500 ml-2'>非常简单</span>"
                                }
                            }
                        },
                        {
                            "label": "分值",
                            "content": "<span class='text-black font-black ml-2 text-xs'>$score分</span>"
                        },
                        {
                            "label": "标签",
                            "content": {
                                "type": "each",
                                "className": "inline-block ml-2",
                                "name": "$tag_list",
                                "items": {
                                    "type": "tpl",
                                    "tpl": "<span class='label bg-gray-400 ml-2 text-xs'>${item}</span> "
                                }
                            },
                            "span": 3
                        },
                        {
                            "label": "来源",
                            "content": {
                                "type": "each",
                                "className": "inline-block ml-2",
                                "name": "$source_list",
                                "items": {
                                    "type": "tpl",
                                    "tpl": "<span class='label bg-gray-400 ml-2 text-xs'>${item}</span> "
                                }
                            },
                            "span": 3
                        }
                    ]
                },
                {
                    "type": "tpl",
                    "className": "m-t text-right",
                    "tpl": "<p><span>$operator / $update_time</span></p>"
                }
            ],
            "toolbar": [
                {
                    "type": "tpl",
                    "visibleOn": "parent_id > 0",
                    "tpl": "<span class=' label label-danger mr-2'>G</span>"
                },
                {
                    "type": "button",
                    "label": "预览",
                    "icon": "fa fa-file-text-o",
                    "className": "text-xs text-black mr-2",
                    "actionType": "dialog",
                    "dialog": {
                        "actions": [],
                        "size": "lg",
                        "title": "预览",
                        "body": {
                            "type": "service",
                            "schemaApi": "/mapi/mock/question_detail?qid=$qid&preview=1"
                        }
                    }
                },
                {
                    "type": "button",
                    "label": "复制",
                    "icon": "fa fa-copy",
                    "className": "text-xs text-black mr-2",
                    "actionType": "link",
                    "link": "/question/copy?qid=$qid"
                },
                {
                    "type": "dropdown-button",
                    "level": "link",
                    "align": "right",
                    "icon": "fa fa-ellipsis-h",
                    "hideCaret": true,
                    "buttons": [
                        {
                            "type": "button",
                            "label": "修改状态",
                            "level": "link",
                            "actionType": "dialog",
                            "dialog": {
                                "title": "调整分值",
                                "body": [
                                    {
                                        "type": "form",
                                        "name": "question-update-state-form",
                                        "reload": "question_lists",
                                        "api": {
                                            "method": "post",
                                            "url": "/mapi/mock/question_update?qid=${qid}",
                                            "dataType": "form"
                                        },
                                        "body": [
                                            {
                                                "type": "alert",
                                                "level": "danger",
                                                "className": "p-2 mt-2 ml-3 shadow rounded",
                                                "showIcon": true,
                                                "body": "<div style='font-weight:bold;'>下线的试题无法新关联试卷, 但已关联场景下会正常外显.</div>"
                                            },
                                            {
                                                "label": "修改状态",
                                                "type": "select",
                                                "name": "state",
                                                "options": [
                                                    {
                                                        "label": "正常",
                                                        "value": "1"
                                                    },
                                                    {
                                                        "label": "下线",
                                                        "value": "2"
                                                    }
                                                ],
                                                "desc": ""
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "type": "button",
                            "actionType": "ajax",
                            "label": "删除",
                            "disabledOn": "this.frequency > 0",
                            "confirmText": "您确认要删除试题么? 如果删除, 关联的试卷将下线该试题",
                            "api": {
                                "method": "get",
                                "url": "/mapi/mock/question_delete?qid=$qid"
                            }
                        }
                    ]
                }
            ]
        }
    }
}