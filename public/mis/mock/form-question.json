{
    "type": "page",
    "body": [
        {
            "type": "alert",
            "level": "info",
            "className": "p-2 mb-2",
            "showIcon": true,
            "title": "操作说明",
            "body": [
                {
                    "type": "tpl",
                    "tpl": "使用前请先阅读"
                },
                {
                    "type": "button",
                    "level": "link",
                    "label": "<试题创建规则>",
                    "actionType": "dialog",
                    "dialog": {
                        "size": "lg",
                        "title": "充值",
                        "body": "123"
                    }
                },
                {
                    "type": "tpl",
                    "tpl": "再进行操作"
                }
            ]
        },
        {
            "type": "tabs",
            "tabsMode": "radio",
            "tabs": [
                {
                    "title": "单项题",
                    "body": {
                        "type": "form",
                        "api": {
                            "method": "post",
                            "url": "/mapi/mock/question_create",
                            "dataType": "form"
                        },
                        "title": "",
                        "autoFocus": true,
                        "body": [
                            {
                                "type": "combo",
                                "name": "single_question_premeta_combo",
                                "label": "前置材料",
                                "multiple": true,
                                "maxLength": 1,
                                "items": [
                                    {
                                        "type": "input-rich-text",
                                        "name": "single_question_premeta",
                                        "options": {
                                            "menubar": false,
                                            "height": 200,
                                            "plugins": [
                                                "advlist",
                                                "autolink",
                                                "link",
                                                "image",
                                                "lists",
                                                "charmap",
                                                "preview",
                                                "anchor",
                                                "pagebreak",
                                                "searchreplace",
                                                "wordcount",
                                                "visualblocks",
                                                "visualchars",
                                                "code",
                                                "fullscreen",
                                                "insertdatetime",
                                                "media",
                                                "nonbreaking",
                                                "table",
                                                "emoticons",
                                                "template",
                                                "help"
                                            ],
                                            "toolbar": "undo redo | formatselect | bold italic backcolor  | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | removeformat | help"
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "group",
                                "body": [
                                    {
                                        "label": "考题类型",
                                        "type": "select",
                                        "name": "single_question_type",
                                        "value": "1",
                                        "options": [
                                            {
                                                "label": "单选题",
                                                "value": "1"
                                            },
                                            {
                                                "label": "多选题",
                                                "value": "2"
                                            },
                                            {
                                                "label": "判断题",
                                                "value": "3"
                                            },
                                            {
                                                "label": "填空题",
                                                "value": "4"
                                            },
                                            {
                                                "label": "简答题",
                                                "value": "5"
                                            },
                                            {
                                                "label": "写作题",
                                                "value": "6"
                                            }
                                        ]
                                    },
                                    {
                                        "label": "难度",
                                        "type": "select",
                                        "name": "single_question_level",
                                        "value": "3",
                                        "options": [
                                            {
                                                "label": "非常简单",
                                                "value": "1"
                                            },
                                            {
                                                "label": "简单",
                                                "value": "2"
                                            },
                                            {
                                                "label": "一般",
                                                "value": "3"
                                            },
                                            {
                                                "label": "较难",
                                                "value": "4"
                                            },
                                            {
                                                "label": "超难",
                                                "value": "5"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "tree-select",
                                        "name": "single_question_tag",
                                        "label": "标签",
                                        "placeholder": "非必选",
                                        "multiple": true,
                                        "initiallyOpen": false,
                                        "onlyLeaf": true,
                                        "searchable": true
                                    }
                                ]
                            },
                            {
                                "type": "alert",
                                "level": "success",
                                "visibleOn": "this.single_question_type == 1 || this.single_question_type == 2",
                                "body": "请从选项中选出正确的答案, 最少2个最多6个选项, 勾选即为正确答案"
                            },
                            {
                                "type": "alert",
                                "level": "success",
                                "visibleOn": "this.single_question_type == 3",
                                "body": "判断题勾选即为正确答案"
                            },
                            {
                                "type": "alert",
                                "level": "success",
                                "visibleOn": "this.single_question_type == 4",
                                "body": "填空题空格录入方式为连续输入5个下划线，例如：What _____ is your _____?"
                            },
                            {
                                "type": "tpl",
                                "tpl": "<p style='font-weight:900;'>题干</p>"
                            },
                            {
                                "type": "input-rich-text",
                                "name": "single_question_content",
                                "options": {
                                    "menubar": false,
                                    "height": 200,
                                    "plugins": [
                                        "advlist",
                                        "autolink",
                                        "link",
                                        "image",
                                        "lists",
                                        "charmap",
                                        "preview",
                                        "anchor",
                                        "pagebreak",
                                        "searchreplace",
                                        "wordcount",
                                        "visualblocks",
                                        "visualchars",
                                        "code",
