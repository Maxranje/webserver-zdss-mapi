                            },
                            {
                                "type": "tpl",
                                "tpl": "<p style='font-weight:900;'>答案</p>"
                            },
                            {
                                "type": "combo",
                                "name": "single_answers_radio",
                                "multiple": true,
                                "addable": true,
                                "removable": true,
                                "maxLength": 6,
                                "minLength": 2,
                                "visibleOn": "this.single_question_type == 1",
                                "items": [
                                    {
                                        "type": "radio",
                                        "name": "is_answer",
                                        "columnClassName": "no-grow"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "answer_content",
                                        "placeholder": "请输入答案"
                                    }
                                ]
                            },
                            {
                                "type": "combo",
                                "name": "single_answers_checkbox",
                                "multiple": true,
                                "addable": true,
                                "removable": true,
                                "maxLength": 6,
                                "minLength": 2,
                                "visibleOn": "this.single_question_type == 2",
                                "items": [
                                    {
                                        "name": "is_answer",
                                        "type": "checkbox",
                                        "mode": "inline",
                                        "label": ""
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "answer_content",
                                        "placeholder": "请输入答案"
                                    }
                                ]
                            },
                            {
                                "name": "single_answers_check",
                                "type": "radios",
                                "visibleOn": "this.single_question_type == 3",
                                "options": [
                                    {
                                        "label": "对",
                                        "value": "1"
                                    },
                                    {
                                        "label": "错",
                                        "value": "2"
                                    }
                                ]
                            },
                            {
                                "type": "combo",
                                "label": "答案顺序必须与配置空格顺序一一对应",
                                "name": "single_answers_fill",
                                "multiple": true,
                                "addable": true,
                                "removable": true,
                                "visibleOn": "this.single_question_type == 4",
                                "items": [
                                    {
                                        "type": "input-text",
                                        "name": "answer_content",
                                        "placeholder": "请输入答案"
                                    }
                                ]
                            },
                            {
                                "name": "single_answer_write",
                                "type": "textarea",
                                "showCounter": true,
                                "maxLength": 400,
                                "visibleOn": "this.single_question_type == 5 || this.single_question_type == 6",
                                "placeholder": "请输入答案"
                            }
                        ],
                        "actions": [
                            {
                                "type": "button",
                                "label": "重置",
                                "actionType": "reset"
                            },
                            {
                                "type": "button",
                                "label": "提交",
                                "level": "primary",
                                "actionType": "submit"
                            }
                        ]
