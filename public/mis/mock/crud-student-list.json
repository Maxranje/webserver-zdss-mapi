{
    "type": "page",
    "body": {
        "type": "crud",
        "id": "student_list",
        "api": {
            "method": "post",
            "url": "/mapi/student/lists?from_page=mock",
            "dataType": "form"
        },
        "perPage": 10,
        "perPageAvailable": [
            5,
            10,
            20
        ],
        "syncLocation": false,
        "labelTpl": "${uid}",
        "filter": {
            "title": "条件搜索",
            "submitText": "",
            "body": [
                {
                    "type": "input-text",
                    "name": "name",
                    "size": "md",
                    "label": "登录名",
                    "placeholder": "严格搜索"
                },
                {
                    "type": "input-text",
                    "name": "nickname",
                    "size": "md",
                    "label": "学员昵称",
                    "placeholder": "支持模糊搜索"
                },
                {
                    "type": "input-text",
                    "name": "phone",
                    "size": "md",
                    "label": "手机号",
                    "placeholder": "严格搜索"
                },
                {
                    "type": "tree-select",
                    "name": "sop_uid",
                    "searchable": true,
                    "onlyLeaf": true,
                    "label": "学管",
                    "size": "md",
                    "source": "/mapi/api/soplists"
                },
                {
                    "type": "input-text",
                    "name": "is_mock",
                    "hidden": true,
                    "value": 1
                },
                {
                    "type": "submit",
                    "label": "搜索"
                }
            ]
        },
        "filterTogglable": true,
        "headerToolbar": [
            "filter-toggler",
            "bulkActions",
            {
                "type": "button",
                "actionType": "drawer",
                "label": "新增",
                "className": "border-solid border-gray-100 p-4 rounded",
                "icon": "fa fa-plus",
                "level": "info",
                "drawer": {
                    "position": "right",
                    "size": "lg",
                    "title": "新增",
                    "body": {
                        "type": "form",
                        "name": "student-new-form",
                        "api": {
                            "method": "post",
                            "url": "/mapi/student/create",
                            "dataType": "form"
                        },
                        "onEvent": {
                            "click": {
                                "actions": [
                                    {
                                        "actionType": "reload",
                                        "componentId": "student_list"
                                    }
                                ]
                            }
                        },
                        "body": [
                            {
                                "type": "input-text",
                                "name": "nickname",
                                "label": "昵称",
                                "required": true
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "input-text",
                                "name": "name",
                                "label": "登录名",
                                "desc": "建议用拼音, 例如昵称:王聪聪 登录名:wang.cc",
                                "required": true
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "input-text",
                                "name": "phone",
                                "label": "手机号",
                                "desc": "6位到12位之间, 手机号会作为账户默认登录密码, 重置密码也是如此",
                                "required": true
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "radios",
                                "name": "sex",
                                "label": "性别",
                                "value": "M",
                                "options": [
                                    {
                                        "label": "男",
                                        "value": "M"
                                    },
                                    {
                                        "label": "女",
                                        "value": "F"
                                    }
                                ],
                                "required": true
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "tree-select",
                                "name": "birthplace",
                                "onlyLeaf": true,
                                "label": "生源地",
                                "searchable": true,
                                "initiallyOpen": false,
                                "required": true,
                                "source": "/mapi/birthplace/lists?is_select=1"
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "input-text",
                                "name": "school",
                                "label": "学校"
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "input-text",
                                "name": "graduate",
                                "label": "学级"
                            },
                            {
                                "type": "divider"
                            },
                            {
                                "type": "tree-select",
                                "name": "sopuid",
                                "onlyLeaf": true,
                                "label": "学管",
                                "searchable": true,
                                "initiallyOpen": false,
                                "source": "/mapi/api/soplists",
                                "required": true
                            },
                            {
                                "type": "input-text",
                                "name": "is_mock",
                                "hidden": true,
                                "value": 1
                            }
                        ]
                    }
                }
            },
            {
                "type": "tpl",
                "tpl": "<span class='font-black'>仅展示标记模考属性学员</span>，共有 ${total} 条数据。",
                "className": "v-middle"
            },
            {
                "type": "columns-toggler",
                "align": "right"
            },
            {
                "type": "drag-toggler",
                "align": "right"
            },
            {
                "type": "pagination",
                "align": "right"
            }
        ],
        "footerToolbar": [
            "statistics",
            "switch-per-page",
            "pagination"
        ],
        "columns": [
            {
                "name": "uid",
                "label": "UID",
                "type": "text",
                "toggled": true
            },
            {
                "name": "nickname",
                "label": "昵称",
                "type": "text",
                "toggled": true
            },
            {
                "name": "name",
                "label": "登录名",
                "type": "text",
                "toggled": true
            },
            {
                "name": "phone",
                "label": "手机号",
                "type": "text",
                "toggled": false
            },
            {
                "name": "state",
                "label": "状态",
                "type": "mapping",
                "remark": "休眠/完结状态根据3个月或12个月是否有结算来确定",
                "map": {
                    "4": "<span class='label label-default'>完结</span>",
                    "3": "<span class='label label-danger'>休眠</span>",
                    "2": "<span class='label label-danger'>下线</span>",
                    "1": "<span class='label label-success'>正常</span>"
                }
            },
            {
                "name": "sex",
                "label": "性别",
                "type": "mapping",
                "map": {
                    "M": "男",
                    "F": "女"
                }
            },
            {
                "name": "birthplace",
                "label": "生源地",
                "type": "text",
                "toggled": true
            },
            {
                "name": "school",
                "label": "学校",
                "type": "text",
                "toggled": false
            },
            {
                "name": "graduate",
                "label": "学级",
                "type": "text",
                "toggled": false
            },
            {
                "name": "sop_name",
                "label": "学管",
                "type": "text",
                "toggled": true
            },
            {
                "name": "exam_done_count",
                "label": "已考次数",
                "type": "text",
                "toggled": true
            },
            {
                "name": "exam_unable_count",
                "label": "待考次数",
                "type": "text",
                "toggled": true
            },
            {
                "name": "score",
                "label": "综合评分",
                "type": "text",
                "remark": "综合评分",
                "toggled": false
            },
            {
                "name": "update_time",
                "label": "更新时间",
                "type": "text",
                "toggled": false
            },
            {
                "type": "operation",
                "label": "操作",
                "fixed": "right",
                "width": 150,
                "buttons": [
                    {
                        "type": "button",
                        "label": "编辑",
                        "actionType": "drawer",
                        "disabledOn": "this.is_partner === 1 || this.is_edit !== 1",
                        "drawer": {
                            "position": "right",
                            "size": "lg",
                            "title": "编辑",
                            "body": {
                                "type": "form",
                                "name": "sample-edit-form",
                                "api": {
                                    "method": "post",
                                    "url": "/mapi/student/update",
                                    "dataType": "form"
                                },
                                "onEvent": {
                                    "click": {
                                        "actions": [
                                            {
                                                "actionType": "reload",
                                                "componentId": "student_list"
                                            }
                                        ]
                                    }
                                },
                                "body": [
                                    {
                                        "type": "input-text",
                                        "name": "uid",
                                        "label": "Uid",
                                        "disabled": true
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "is_mock",
                                        "hidden": true,
                                        "value": 1
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "nickname",
                                        "label": "昵称",
                                        "required": true
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "name",
                                        "label": "登录名",
                                        "required": true
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "phone",
                                        "label": "手机号",
                                        "desc": "6位到12位之间, 只有在创建时候才会设置默认密码为手机号, 修改不会更新密码, 如要同步为手机号, 请重置密码",
                                        "required": true
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "radios",
                                        "name": "sex",
                                        "label": "性别",
                                        "value": "{$data.sex}",
                                        "options": [
                                            {
                                                "label": "男",
                                                "value": "M"
                                            },
                                            {
                                                "label": "女",
                                                "value": "F"
                                            }
                                        ],
                                        "required": true
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "radios",
                                        "name": "state",
                                        "label": "状态",
                                        "value": "{$data.state}",
                                        "options": [
                                            {
                                                "label": "正常",
                                                "value": "1"
                                            },
                                            {
                                                "label": "下线",
                                                "value": "2"
                                            }
                                        ],
                                        "required": true
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "tree-select",
                                        "name": "bpid",
                                        "onlyLeaf": true,
                                        "label": "生源地",
                                        "searchable": true,
                                        "initiallyOpen": false,
                                        "required": true,
                                        "source": "/mapi/birthplace/lists?is_select=1",
                                        "desc": "修改生源地不会影响该学员已有订单中生源地信息(创建订单时学员数据作为依据)"
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "school",
                                        "label": "学校"
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "input-text",
                                        "name": "graduate",
                                        "label": "学级"
                                    },
                                    {
                                        "type": "divider"
                                    },
                                    {
                                        "type": "tree-select",
                                        "name": "sop_uid",
                                        "onlyLeaf": true,
                                        "label": "学管",
                                        "searchable": true,
                                        "initiallyOpen": false,
                                        "source": "/mapi/api/soplists",
                                        "required": true,
                                        "desc": "学管更新会同步更新到排课列表中"
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "button",
                        "label": "错题本",
                        "actionType": "link",
                        "level": "primary",
                        "link": "/wrong/student?student_uid=$uid"
                    },
                    {
                        "type": "button",
                        "actionType": "ajax",
                        "label": "删除",
                        "level": "danger",
                        "disabledOn": "this.is_partner === 1",
                        "confirmText": "您确认要删除学员么? 如果关联订单/留学服务/模考则无法删除, 建议下线处理!",
                        "api": {
                            "method": "get",
                            "url": "/mapi/student/delete?uid=$uid"
                        }
                    }
                ],
                "toggled": true
            }
        ]
    }
}