{
    "type": "page",
    "body": {
        "type": "crud",
        "id": "question_lists",
        "api": {
            "method": "post",
            "url": "/mapi/mock/question_lists",
            "dataType": "form"
        },
        "perPage": 20,
        "perPageAvailable": [
            10,
            20,
            30
        ],
        "syncLocation": false,
        "labelTpl": "${qid}",
        "filter": {
            "title": "条件搜索",
            "submitText": "",
            "body": [
                {
                    "type": "input-text",
                    "name": "qids",
                    "size": "md",
                    "label": "试题ID",
                    "placeholder": "多个用英文逗号分隔"
                },
                {
                    "type": "input-text",
                    "name": "description",
                    "size": "md",
                    "label": "简述",
                    "placeholder": "模糊匹配简述"
                },
                {
                    "label": "题型",
                    "type": "select",
                    "size": "md",
                    "clearable": true,
                    "name": "type",
                    "options": [
                        {
                            "label": "单选题",
                            "value": "1"
                        },
                        {
                            "label": "多选题",
                            "value": "2"
                        },
                        {
                            "label": "判断题",
                            "value": "3"
                        },
                        {
                            "label": "填空题",
                            "value": "4"
                        },
                        {
                            "label": "简答题",
                            "value": "5"
                        },
                        {
                            "label": "写作题",
                            "value": "6"
                        },
                        {
                            "label": "听力题",
                            "value": "7"
                        },
                        {
                            "label": "口语题",
                            "value": "8"
                        }
                    ]
                },
                {
                    "label": "难度",
                    "type": "select",
                    "size": "md",
                    "clearable": true,
                    "name": "level",
                    "options": [
                        {
                            "label": "非常简单",
                            "value": "1"
                        },
                        {
                            "label": "简单",
                            "value": "2"
                        },
                        {
                            "label": "一般",
                            "value": "3"
                        },
                        {
                            "label": "较难",
                            "value": "4"
                        },
                        {
                            "label": "超难",
                            "value": "5"
                        }
                    ]
                },
                {
                    "type": "tree-select",
                    "name": "tag_ids",
                    "onlyLeaf": true,
                    "multiple": true,
                    "searchable": true,
                    "initiallyOpen": false,
                    "size": "md",
                    "label": "标签",
                    "source": "/mapi/mock/tag_lists?is_select=1"
                },
                {
                    "type": "tree-select",
                    "name": "subject_ids",
                    "onlyLeaf": true,
                    "multiple": true,
                    "searchable": true,
                    "initiallyOpen": false,
                    "size": "md",
                    "label": "科目",
                    "source": "/mapi/subject/lists?is_select=1&is_leaf=1"
                },
                {
                    "type": "submit",
                    "label": "搜索"
                }
            ]
        },
        "filterTogglable": true,
        "headerToolbar": [
            "filter-toggler",
            {
                "type": "button",
                "label": "新增",
                "actionType": "link",
                "className": "border-solid border-gray-100 p-4 rounded",
                "level": "info",
                "icon": "fa fa-plus",
                "link": "/question/detail"
            },
            {
                "type": "tpl",
                "tpl": "共有 ${total} 条数据。",
                "className": "v-middle"
            },
            {
                "type": "pagination",
                "align": "right"
            }
        ],
        "footerToolbar": [
            "statistics",
            "switch-per-page",
            "pagination"
        ],
        "mode": "cards",
        "columnsCount": 1,
        "card": {
            "className": "border-solid border-gray-100 shadow p-4 rounded-md mt-5 -mb-2 ",
            "header": {
                "className": "bg-white",
                "title": "QuestionID $qid",
                "subTitle": "$description"
            },
            "body": [
                {
                    "type": "property",
                    "column": 3,
                    "mode": "simple",
                    "className": "border-solid border-gray-100 shadow-md p-4 rounded-lg bg-gray-50",
                    "items": [
                        {
                            "label": "题型",
                            "content": "<span class='text-black font-black ml-2 text-xs'>$type_info</span>"
                        },
                        {
                            "label": "难度",
                            "content": {
                                "name": "level",
                                "label": "状态",
                                "type": "mapping",
                                "map": {
                                    "5": "<span class='label label-danger text-xs ml-2'>困难</span>",
                                    "4": "<span class='label label-warning text-xs ml-2'>较难</span>",
                                    "3": "<span class='label label-info text-xs ml-2'>一般</span>",
                                    "2": "<span class='label label-danger text-xs ml-2'>简单</span>",
                                    "1": "<span class='label label-success text-xs ml-2'>非常简单</span>"
                                }
                            }
                        },
                        {
                            "label": "科目",
                            "content": "<span class='ml-2'>$subject_name</span>"
                        },
                        {
                            "label": "标签",
                            "content": {
                                "type": "each",
                                "className": "inline-block ml-2",
                                "name": "$tag_list",
                                "items": {
                                    "type": "tpl",
                                    "tpl": "<span class='label bg-gray-400 ml-2 text-xs'>${item}</span> "
                                }
                            },
                            "span": 3
                        }
                    ]
                },
                {
                    "type": "tpl",
                    "className": "m-t text-right",
                    "tpl": "<p><span>$operator / $update_time</span></p>"
                }
            ],
            "toolbar": [
                {
                    "type": "tpl",
                    "visibleOn": "parent_id > 0",
                    "tpl": "<span class=' label label-danger mr-2'>G</span>"
                },
                {
                    "type": "button",
                    "label": " View",
                    "icon": "fa fa-location-arrow",
                    "className": "text-xs text-black mr-2",
                    "actionType": "dialog",
                    "dialog": {
                        "actions": [],
                        "size": "lg",
                        "title": "预览",
                        "body": {
                            "type": "service",
                            "schemaApi": "/mapi/mock/question_detail?qid=$qid&preview=1"
                        }
                    }
                },
                {
                    "type": "button",
                    "label": "Edit",
                    "icon": "fa fa-edit",
                    "className": "text-xs text-black mr-2",
                    "actionType": "link",
                    "link": "/question/detail?qid=$qid&parent_id=$parent_id"
                },
                {
                    "type": "dropdown-button",
                    "level": "link",
                    "align": "right",
                    "icon": "fa fa-ellipsis-h",
                    "hideCaret": true,
                    "buttons": [
                        {
                            "type": "button",
                            "actionType": "ajax",
                            "label": "删除",
                            "disabledOn": "this.frequency > 0",
                            "confirmText": "您确认要删除试题么? 如果删除, 关联的试卷将下线该试题",
                            "api": {
                                "method": "get",
                                "url": "/mapi/mock/question_delete?qid=$qid"
                            }
                        }
                    ]
                }
            ]
        }
    }
}